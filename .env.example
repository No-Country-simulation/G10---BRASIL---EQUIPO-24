# MediFlow: modelo de configuração
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NÃO deve ir para o GitHub (já está no .gitignore).

# ---------------------------------------------------------------------------
# Gemini (obrigatório para processar documentos)
# Crie a chave no Google AI Studio.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=cole_sua_chave_aqui
# Opcional: trocar o modelo sem mexer no código
# GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Onde guardar os arquivos: local | seaweedfs | oci | auto
# "local" grava numa pasta do seu computador (não precisa de Docker nem de nuvem).
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
# ARMAZENAMENTO_LOCAL_DIR=armazenamento_local

# ---------------------------------------------------------------------------
# SeaweedFS no Docker (opcional): use com STORAGE_BACKEND=seaweedfs
# Suba com: docker compose up -d
# ---------------------------------------------------------------------------
# SEAWEEDFS_ENDPOINT=http://localhost:8333
# SEAWEEDFS_BUCKET=mediflow-documentos-clinicos
# SEAWEEDFS_ACCESS_KEY=seu_usuario_local
# SEAWEEDFS_SECRET_KEY=sua_senha_local
# SEAWEEDFS_REGION=us-east-1

# ---------------------------------------------------------------------------
# OCI Object Storage (opcional): use com STORAGE_BACKEND=oci
# Use apenas recursos Always Free.
# ---------------------------------------------------------------------------
# OCI_NAMESPACE=seu_namespace
# OCI_BUCKET=mediflow-documentos-clinicos
# OCI_CONFIG_FILE=~/.oci/config
# OCI_PROFILE=DEFAULT

# ---------------------------------------------------------------------------
# Regras de triagem (opcional): caminho do arquivo de configuração
# ---------------------------------------------------------------------------
# CONFIG_TRIAGEM=config_triagem.json
